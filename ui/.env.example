# Copy this file to .env and fill in the contract address.
# Deploy the contract first:
#   cd contracts && forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast --private-key <ANVIL_KEY>
# Then paste the deployed address below.

VITE_CONTRACT_ADDRESS=

# Network configuration — defaults to Anvil local if not set
# VITE_CHAIN_ID=0x7a69
# VITE_CHAIN_NAME=Anvil Local
# VITE_RPC_URL=http://127.0.0.1:8545

# Sepolia testnet example:
# VITE_CHAIN_ID=0xaa36a7
# VITE_CHAIN_NAME=Sepolia
# VITE_RPC_URL=https://rpc.sepolia.org
