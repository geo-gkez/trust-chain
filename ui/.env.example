# Copy this file to .env (values below work for a fresh local Anvil instance)

# Deterministic address: deployer is Anvil account 0 at nonce 0 — always the same
# VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Optional — defaults work for a local Anvil instance
# VITE_CHAIN_ID=0x7a69
# VITE_CHAIN_NAME=Anvil Local
# VITE_RPC_URL=http://127.0.0.1:8545

VITE_CONTRACT_ADDRESS=<contract-address-on-sepolia>
VITE_CHAIN_ID=<chain-id-for-sepolia>
VITE_CHAIN_NAME=<chain-name-for-sepolia>
VITE_RPC_URL=<rpc-url-for-sepolia>
VITE_DEPLOY_BLOCK=<block-number-where-contract-is-deployed-on-sepolia>
VITE_SUBGRAPH_URL=<subgraph-url-for-sepolia>
