# Copy this file to .env and fill in your values — NEVER commit .env
#
# 1. PRIVATE_KEY: export from MetaMask (Account Details → Export Private Key)
#    Use a dedicated deployment wallet, NOT your daily wallet
PRIVATE_KEY=0x<your-deployer-wallet-private-key>
#
# 2. SEPOLIA_RPC: Alchemy or Infura endpoint for Ethereum Sepolia
#    Alchemy: https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
#    Infura:  https://sepolia.infura.io/v3/<your-project-id>
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/<your-api-key>
#
# 3. ETHERSCAN_API_KEY: from etherscan.io → API Keys
#    Used by forge --verify to publish the contract source code
ETHERSCAN_API_KEY=<your-etherscan-api-key>
